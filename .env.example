# Add these in your hosting provider's environment settings. Never commit the real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# Optional Neon default instead of Supabase. Never commit a real database password.
NEON_DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Optional trusted CA bundle path if automatic detection fails.
# NEON_SSL_ROOT_CERT=/etc/ssl/cert.pem
